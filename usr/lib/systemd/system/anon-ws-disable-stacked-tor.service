#### meta start
#### project Whonix
#### category networking and apps
#### workstation_only yes
#### description
## Runs <code>/usr/libexec/anon-ws-disable-stacked-tor/state-files</code> and
## <code>/usr/libexec/anon-ws-disable-stacked-tor/socat-unix-sockets</code>.
#### meta end

[Unit]
Description=anon-ws-disable-stacked-tor
Documentation=https://www.whonix.org/wiki/Dev/anon-ws-disable-stacked-tor
ConditionPathExists=!/run/qubes/this-is-templatevm

After=network.target
Wants=network.target

[Service]
Type=simple
Restart=always
TimeoutSec=30
KillMode=control-group
SuccessExitStatus=143 125
RestartPreventExitStatus=125
PermissionsStartOnly=true
ExecStartPre=/usr/libexec/anon-ws-disable-stacked-tor/state-files
User=debian-tor
ExecStart=/usr/libexec/anon-ws-disable-stacked-tor/socat-unix-sockets

## W^X hardening (anonymous + file-backed). MemoryDenyWriteExecute denies anon
## W+X / mprotect/shmat gaining PROT_EXEC; SystemCallArchitectures=native closes
## the secondary-ABI bypass; LockPersonality blocks READ_IMPLIES_EXEC;
## SystemCallFilter=~memfd_create kills the memfd bypass; NoExecPaths marks the
## writable dirs non-executable. state-files + socat-unix-sockets are bash
## (dropped-priv, debian-tor), no JIT.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LockPersonality=yes
SystemCallFilter=~memfd_create
NoExecPaths=/run /tmp /var/tmp /dev/shm

[Install]
WantedBy=multi-user.target
